# Packages Zano's OFFICIAL linux x64 release binary instead of self-compiling.
#
# Why: the from-source linux/arm64 build of 2.2.0 rejects canonical mainnet blocks
# (wrong inputs in transactions -> MDB_BAD_TXN); proven by controlled experiment to be
# an aarch64 source defect, not fixable via build flags (tested -fsigned-char and
# -O0 + UB-hardening, all crash). Upstream ships x64 only and no container image, so we
# wrap the official x64 binary and run it under Rosetta on the Apple-silicon hosts.
# The legacy self-compile ./Dockerfile is kept for testnet / custom-ref builds.
ARG UBUNTU_RUNNER_VERSION=24.04

# Official Zano release to package (build.zano.org).
ARG ZANO_VERSION=2.2.0.487
ARG ZANO_COMMIT=211dea6

FROM ubuntu:${UBUNTU_RUNNER_VERSION} AS extract
ARG ZANO_VERSION
ARG ZANO_COMMIT
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
RUN curl -fSL -o zano.AppImage \
      "https://build.zano.org/builds/zano-linux-x64-release-v${ZANO_VERSION}%5B${ZANO_COMMIT}%5D.AppImage" && \
    chmod +x zano.AppImage && \
    ./zano.AppImage --appimage-extract && \
    ./squashfs-root/usr/bin/zanod --version | grep -q "${ZANO_VERSION}\[${ZANO_COMMIT}\]"

###############################################################################
FROM ubuntu:${UBUNTU_RUNNER_VERSION} AS zano-runner

WORKDIR /zano
ENV DEBIAN_FRONTEND=noninteractive

RUN mkdir /home/ubuntu/.Zano /home/ubuntu/private && \
    chown ubuntu:ubuntu /home/ubuntu/.Zano /home/ubuntu/private && \
    chmod og-rwx /home/ubuntu/.Zano /home/ubuntu/private

COPY --from=extract /opt/squashfs-root/usr/bin/zanod /usr/bin/zanod
COPY --from=extract /opt/squashfs-root/usr/bin/simplewallet /usr/bin/simplewallet
COPY ./include/zano-startup.sh /usr/bin/zano-startup.sh

USER ubuntu
WORKDIR /home/ubuntu

EXPOSE 11121 11211

VOLUME [ "/home/ubuntu/.Zano" , "/home/ubuntu/private" ]

ENTRYPOINT [ "/usr/bin/zano-startup.sh" ]
